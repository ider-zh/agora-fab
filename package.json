{
  "name": "agorafab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.22.1 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/browser/**'",
    "test:integration": "node scripts/test-integration.mjs",
    "test:browser": "vitest run tests/browser",
    "test:smoke": "node scripts/smoke.mjs",
    "db:generate": "pnpm --filter @agorafab/db db:generate",
    "db:migrate": "pnpm --filter @agorafab/db db:migrate",
    "db:seed": "pnpm --filter @agorafab/db db:seed",
    "env:init": "node scripts/init-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.19.15",
    "eslint": "9.39.1",
    "globals": "17.5.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.0.18"
  }
}
