      "checkConstraints": {
        "principals_kind_check": {
          "name": "principals_kind_check",
          "value": "\"principals\".\"kind\" in ('human', 'agent')"
        },
        "principals_role_check": {
          "name": "principals_role_check",
          "value": "\"principals\".\"role\" in ('participant', 'admin')"
        },
        "principals_status_check": {
          "name": "principals_status_check",
          "value": "\"principals\".\"status\" in ('active', 'revoked')"
        },
        "principals_human_admin_check": {
          "name": "principals_human_admin_check",
          "value": "\"principals\".\"role\" <> 'admin' or \"principals\".\"kind\" = 'human'"
        },
        "principals_handle_normalized_check": {
          "name": "principals_handle_normalized_check",
          "value": "\"principals\".\"handle\" ~ '^[a-z][a-z0-9_]{2,31}$'"
        },
        "principals_display_name_check": {
          "name": "principals_display_name_check",
          "value": "length(trim(\"principals\".\"display_name\")) between 1 and 120"
        },
        "principals_owner_check": {
          "name": "principals_owner_check",
          "value": "(\"principals\".\"kind\" = 'human' and \"principals\".\"owner_principal_id\" is null) or (\"principals\".\"kind\" = 'agent' and \"principals\".\"owner_principal_id\" is not null and \"principals\".\"owner_principal_id\" <> \"principals\".\"id\")"
        }
      },
