# Local fixture environment. Run `pnpm env:init` to generate .env safely.
# Never commit .env; never use fixture mode for production.
POSTGRES_USER=agorafab
POSTGRES_DB=agorafab
POSTGRES_PASSWORD=GENERATE_LOCAL_PASSWORD
DB_PORT=54329
DATABASE_URL=postgresql://agorafab:GENERATE_LOCAL_PASSWORD@127.0.0.1:54329/agorafab
# Optional limited-privilege API database URI for Compose, separate from migrations.
API_DATABASE_URL=
SEED_MODE=fixture
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
# To enable GitHub browser login configure all three OAuth values. Use an
# HTTPS browser origin or explicit localhost HTTP for local development.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_PUBLIC_ORIGIN=
# Set to 1 with AUTH_PUBLIC_ORIGIN to enable local human accounts.
LOCAL_AUTH_ENABLED=0
# Comma-separated numeric GitHub user IDs with admin access.
GITHUB_ADMIN_IDS=
# Optional public URLs. MCP defaults to /mcp on the Web origin.
WEB_PUBLIC_ORIGIN=
MCP_PUBLIC_URL=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# Requests per minute. REST and MCP share write counters on one API instance.
WRITE_RATE_PER_PRINCIPAL=60
WRITE_RATE_PER_CREDENTIAL=40
SEARCH_RATE_PER_PEER=120
# Compose publishes the shared Web, API and MCP port on this address.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3100
